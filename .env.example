# ShopOps MCP — Environment Variables
#
# Store credentials are NOT configured here — they are passed to the
# `store_connect` tool at runtime. Only the variables below are read by
# the server. All are optional.

# ─── Server transport (optional) ─────────────────────────────────────
# Set PORT (or MCPIZE=true) to run as a Streamable HTTP endpoint instead
# of local stdio. Defaults to 8080 when HTTP mode is active.
# PORT=8080

# ─── Pro License (optional) ──────────────────────────────────────────
# Unlocks Pro tools (inventory_forecast, pricing_optimize, customers_churn,
# order_anomalies, report_weekly). Without a key the server runs in Free tier.
# Buy: https://automatiabcn.lemonsqueezy.com/buy/cbbe44f0-a146-4c65-88c8-71f371037758
# Validation is cached locally for 24h — offline-capable after first run.
LEMONSQUEEZY_LICENSE_KEY=
